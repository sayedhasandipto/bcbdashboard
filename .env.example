# Firebase Configuration Example
# Rename this file to .env.local and fill in your actual Firebase project credentials.
# You can find these credentials in Firebase Console -> Project Settings -> General -> Your Apps.

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bcb-student-result.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://bcb-student-result-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bcb-student-result
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bcb-student-result.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
